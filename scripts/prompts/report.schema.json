{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "testFiles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "productionFiles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "filesToRemove": {
      "type": "array",
      "items": { "type": "string" }
    },
    "doubts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "testsChangedAfterWriting": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "reason": { "type": "string" }
        },
        "required": ["path", "reason"]
      }
    }
  },
  "required": [
    "testFiles",
    "productionFiles",
    "filesToRemove",
    "doubts",
    "testsChangedAfterWriting"
  ]
}
